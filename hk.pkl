amends "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Builtins.pkl"
// Using a coding agent? See https://hk.jdx.dev/agents

local linters = new Mapping {
    ["trailing-whitespace"] = Builtins.trailing_whitespace
    ["newlines"] = Builtins.newlines
    ["mixed-line-ending"] = Builtins.mixed_line_ending

    ["oxfmt"] = (Builtins.oxfmt) {
        types = List("json", "yaml", "markdown")
    }
    ["tombi-format"] = Builtins.tombi_format
    ["cargo_fmt"] = (Builtins.cargo_fmt) {
        check = new CommandSpec {
            command = "cargo +nightly fmt --check --manifest-path {{workspace_indicator}}"
            effect = "read"
        }
        check_list_files = new CommandSpec {
            command = "cargo +nightly fmt --check --manifest-path {{workspace_indicator}} -- --files-with-diff"
            effect = "read"
        }
        fix = new CommandSpec {
            command = "cargo +nightly fmt --manifest-path {{workspace_indicator}}"
            effect = "write"
        }
    }
}

steps = linters
