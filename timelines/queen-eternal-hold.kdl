timeline 1 "Queen Eternal - Castellation hold and exit" {
    // Scope the first 8F00 environment; the post-exit return uses the same ID without restarting this phase.
    start "Ability" id="8F00" source="Queen Eternal"
    wipe "ActorControl" command="4000000F"
    wipe "ActorControl" command="40000010"
    finish "InCombat" inGameCombat="0"
    zone-exit "ChangeZone"
    phase "hold" {
        enter "Ability" id="8F00" source="Queen Eternal" resume-at=0.0
        event "approach-shift" 0.0 name="Virtual Shift"
        event "approach-coronation" 10.2 name="Coronation"
        event "approach-aethertithe" 16.4 name="Aethertithe"
        event "approach-regalia" 22.4 name="Ruthless Regalia"
        event "approach-cone-first" 26.5 name="Aethertithe"
        event "approach-cone-second" 33.6 name="Aethertithe"
        event "approach-cone-third" 40.7 name="Aethertithe"

        // Prosecution belongs inside the cancellable hold: early Castellation can skip even this first attack.
        loop "castellation-hold" start=54.7 every=60.6 {
            event "hold-prosecution" 0.0 name="Prosecution of War" {
                sync 0.0 "Ability" id="8EFA" source="Queen Eternal" before=5.0 after=8.0
            }
            event "hold-force-first" 15.1 name="Legitimate Force"
            event "hold-force-second" 18.2 name="Legitimate Force"
            event "hold-royal" 26.3 name="Royal Domain" {
                sync 26.3 "Ability" id="8EFB" source="Queen Eternal" before=5.0 after=8.0
            }
            event "hold-force-third" 43.5 name="Legitimate Force"
            event "hold-force-fourth" 46.6 name="Legitimate Force"
        }
    }
    phase "castellation" {
        enter "StartsUsing" id="8EFF" source="Queen Eternal" from="hold" at=40.8 before=0.0 after=3600.0
        // Exit timing is measured from the cast start, not the corrected cycle clock.
        event "exit-shift" 5.0 name="Virtual Shift" {
            sync 5.0 "Ability" id="8EFF" source="Queen Eternal" before=2.0 after=5.0
        }
        event "exit-castellation-first" 13.1 name="Castellation"
        event "exit-besiegement-first" 20.8 name="Besiegement"
        event "exit-castellation-second" 30.3 name="Castellation"
        event "exit-besiegement-second" 37.9 name="Besiegement"
        event "exit-besiegement-third" 46.4 name="Besiegement"
        event "exit-force-first" 53.5 name="Legitimate Force"
        event "exit-force-second" 56.6 name="Legitimate Force"
        event "exit-return" 68.7 name="Virtual Shift" {
            sync 68.7 "Ability" id="8F00" source="Queen Eternal" before=5.0 after=8.0
        }
    }
}
