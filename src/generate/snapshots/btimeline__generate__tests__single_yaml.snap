---
source: src/generate/tests.rs
expression: yaml
---
# yaml-language-server: $schema=https://raw.githubusercontent.com/Bing-su/btimeline/main/schema/btimeline-v1.schema.json
entries:
- kind: note
  text: >-
    Draft from FFLogs report new-report fight 2 revision 1 logVersion 76; times are
    relative to fight start.
- at: 0.2
  kind: event
  name: Move
  note: "Sync disabled: another cast matches within the default sync window; source event 0"
  sync:
    enabled: false
    fields:
      id: ^15F91$
      source: ^Helper \(A\)\+$
    log: Ability
- at: 0.5
  kind: event
  name: Move
  sync:
    fields:
      id: ^15F91$
      source: ^Boss$
    log: Ability
- abilities:
  - id: 15F91
    name: Move
  kind: abilityCatalog
schemaVersion: 1
